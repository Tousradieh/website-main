{
  "name": "tousradieh-hammasir-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute hammasir --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute hammasir --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute hammasir --local --file=seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.14.0"
  }
}
